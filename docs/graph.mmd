config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	build(build)
	read(read)
	first_look(first_look)
	ask(ask)
	skip(skip)
	plan(plan)
	decide(decide)
	act(act)
	close(close)
	no_answer(no_answer)
	settle(settle)
	write(write)
