	__start__ --> build;
	act -.-> ask;
	act -.-> close;
	ask -.-> decide;
	ask -.-> plan;
	ask -.-> skip;
	build --> read;
	close -.-> no_answer;
	close -.-> settle;
	close -.-> write;
	decide -.-> act;
	decide -.-> close;
	first_look --> ask;
	plan --> decide;
	read --> first_look;
	repair -.-> finalize;
	repair -.-> verify;
	settle --> write;
	skip -.-> ask;
	skip -.-> close;
	verify -.-> finalize;
	verify -.-> repair;
	write --> verify;
	finalize --> __end__;
	no_answer --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
