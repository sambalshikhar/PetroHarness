---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	open(open)
	turn(turn)
	project(project)
	figures(figures)
	commit(commit)
	__end__([<p>__end__</p>]):::last
	__start__ --> open;
	figures --> commit;
	open --> turn;
	project -.-> commit;
	project -.-> figures;
	turn -.-> commit;
	turn -.-> project;
	commit --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
